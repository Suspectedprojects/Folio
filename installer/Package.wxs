<!--
  Per-user install of Folio: no admin rights needed.
  Installs to %LOCALAPPDATA%\Programs\Folio and adds a Start menu shortcut and an uninstall entry.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Folio"
           Manufacturer="Suspectedprojects"
           Version="$(Version)"
           UpgradeCode="6F2B8A4E-3C1D-4E8B-9A57-1D2C3B4A5F60"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Folio is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FolioIcon" SourceFile="..\Folio\folio.ico" />
    <Property Id="ARPPRODUCTICON" Value="FolioIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Suspectedprojects/Folio" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Folio" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Folio">
      <Component Id="AppExe" Directory="INSTALLFOLDER" Guid="B3E5C2A1-7D4F-4A9C-8E21-5F6A7B8C9D01">
        <File Id="FolioExe" Source="$(PublishDir)Folio.exe" />
        <!-- Per-user components need an HKCU key path -->
        <RegistryValue Root="HKCU" Key="Software\Folio" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>

      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="C4F6D3B2-8E5A-4BAD-9F32-6A7B8C9DAE12">
        <Shortcut Id="FolioShortcut" Name="Folio" Description="Folio file explorer"
                  Target="[INSTALLFOLDER]Folio.exe" WorkingDirectory="INSTALLFOLDER" Icon="FolioIcon" />
        <RegistryValue Root="HKCU" Key="Software\Folio" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
